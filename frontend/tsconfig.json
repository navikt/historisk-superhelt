{
    "extends": "../tsconfig.base.json",
    "include": ["**/*.ts", "**/*.tsx"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "allowJs": true,
        "baseUrl": ".",
        "paths": {
            "~/*": ["./src/*"],
            "@generated": ["./generated"],
            "@generated/*": ["./generated/*"]
        }
    }
}
