{
    "name": "historisk-superhelt",
    "private": true,
    "type": "module",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^26",
            "onFail": "error"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.8.1",
            "onFail": "download"
        }
    },
    "scripts": {
        "start": "pnpm frontend:start",
        "build": "pnpm frontend:build",
        "test": "pnpm --recursive run --if-present test",
        "test:browser": "pnpm --recursive run --if-present test:browser",
        "test:browser:install": "playwright install chromium --with-deps",
        "typecheck": "pnpm --recursive run typecheck",
        "biome": "biome ci .",
        "biome:write": "biome check --write .",
        "frontend:start": "pnpm --filter super-frontend start",
        "frontend:build": "pnpm --filter super-frontend build",
        "api:generate": "pnpm --filter @superhelt/api generate",
        "e2e:test": "pnpm --filter e2e-tests playwright:test",
        "e2e:test:ui": "pnpm --filter e2e-tests playwright:test:ui"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/browser-playwright": "4.1.11",
        "playwright": "^1.63.0",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
